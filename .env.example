# ── Required ─────────────────────────────────────────────────────────────────
# Path to your Ascent .db file (the one from ~/Library/Application Support/Ascent/)
ASCENT_DB_PATH=/path/to/your/ascent.db

# ── Strava Sync (optional) ────────────────────────────────────────────────────
# Get these from https://www.strava.com/settings/api
# Set the "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID=174788
STRAVA_CLIENT_SECRET=your_client_secret_here

# Override if running behind a proxy (default: http://127.0.0.1:8000/strava/callback)
# STRAVA_REDIRECT_URI=http://127.0.0.1:8000/strava/callback

# ── AI Coach + title generation (optional) ───────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Maps / routing (optional; falls back to keyless OSM providers) ────────────
# STADIA_API_KEY=your_stadia_key

# ── Live API test only (venv_arm64/bin/python -m pytest --run-live ...) ───────
# The live Strava check mints a fresh access token from a refresh token using the
# CLIENT_ID/SECRET above. Grab a refresh token from your connected account
# (strava_tokens.json, or the users table's strava_tokens_json).
# STRAVA_REFRESH_TOKEN=your_refresh_token
# Or paste a short-lived access token directly instead:
# STRAVA_ACCESS_TOKEN=your_access_token
